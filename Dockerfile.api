FROM python:3.12-alpine

# API de estadísticas de Senda de Héroes (stdlib, sin dependencias).
# El directorio de datos se deja escribible para poder ejecutarse con UID
# aleatorio no-root (OpenShift/Knative), igual que la imagen web.
WORKDIR /app
COPY api.py /app/api.py
RUN mkdir -p /app/data \
 && chmod -R a+rwX /app/data \
 && addgroup -S app && adduser -S app -G app
USER app

ENV PORT=8000
ENV STATS_DB=/app/data/stats.db
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request as u;u.urlopen('http://localhost:8000/api/health')" || exit 1
CMD ["python", "api.py"]
